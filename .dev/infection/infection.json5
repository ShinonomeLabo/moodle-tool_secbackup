{
    "$schema": "/opt/infection/resources/schema.json",
    "source": {
        "directories": [
            "classes/local/crypto",
            "classes/local/trust",
            "classes/local/api",
            "classes/local/net",
            "classes/local/endpoint"
        ]
    },
    "phpUnit": {
        // The plugin's own phpunit.xml (the plugin root, seen from this folder), made by admin/tool/phpunit/cli/util.php --buildcomponentconfigs.
        "configDir": "../..",
        "customPath": "/var/www/html/vendor/bin/phpunit"
    },
    "bootstrap": "./.dev/infection/bootstrap.php",
    "initialTestsPhpOptions": "-d pcov.enabled=1 -d pcov.directory=.",
    // A mutant whose covering tests take longer than this is skipped, not tested: it is 15 minutes here so that none is.
    "timeout": 900,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true,
        // Mutants that do not change the behaviour. Each entry is one mutator on one line of one method, Class::method::line,
        // and has its row in REVIEW.md, which says why. When the code moves, the line no longer matches and the mutant comes back.
        "CastInt": {
            "ignore": [
                "tool_secbackup\\local\\net\\aws_ranges::network::266",
                "tool_secbackup\\local\\net\\aws_ranges::stored_seq::120",
                "tool_secbackup\\local\\net\\object_transport::declared_length::217",
                "tool_secbackup\\local\\net\\object_transport::get_to_file::175",
                "tool_secbackup\\local\\net\\object_url::parse::94",
                "tool_secbackup\\local\\net\\transport::retry_after::201"
            ]
        },
        "CastString": {
            "ignore": [
                "tool_secbackup\\local\\api\\client::check_upload_headers::779",
                "tool_secbackup\\local\\api\\client::is_sha256::673",
                "tool_secbackup\\local\\api\\client::upload_request::707",
                "tool_secbackup\\local\\api\\enrollment_request::for_this_site::78",
                "tool_secbackup\\local\\api\\enrollment_request::release_text::90",
                "tool_secbackup\\local\\api\\enrollment_request::release_text::91",
                "tool_secbackup\\local\\api\\request_signer::headers::120",
                "tool_secbackup\\local\\crypto\\fingerprint::normalize::57",
                "tool_secbackup\\local\\net\\aws_ranges::bundled::81",
                "tool_secbackup\\local\\net\\aws_ranges::endpoint::129",
                "tool_secbackup\\local\\net\\aws_ranges::stored_endpoint::138",
                "tool_secbackup\\local\\net\\object_transport::declared_length::202",
                "tool_secbackup\\local\\net\\object_transport::is_conditional::228",
                "tool_secbackup\\local\\net\\transport::send::122",
                "tool_secbackup\\local\\trust\\sec_trust::current::67",
                "tool_secbackup\\local\\trust\\sec_trust::key_ids::88"
            ]
        },
        "Concat": {
            "ignore": [
                "tool_secbackup\\local\\api\\client::upload_request::707",
                "tool_secbackup\\local\\net\\aws_ranges::from_json::240",
                "tool_secbackup\\local\\net\\object_url::in_region::121",
                "tool_secbackup\\local\\net\\object_url::parse::83"
            ]
        },
        "DecrementInteger": {
            "ignore": [
                "tool_secbackup\\local\\api\\client::exact_object::611",
                "tool_secbackup\\local\\net\\guarded_options::failure::112",
                "tool_secbackup\\local\\net\\guarded_options::failure::114",
                "tool_secbackup\\local\\net\\object_transport::get_to_file::169",
                "tool_secbackup\\local\\trust\\sec_trust::open::102"
            ]
        },
        "FalseValue": {
            "ignore": [
                "tool_secbackup\\local\\crypto\\signing_keys::load::70",
                "tool_secbackup\\local\\net\\doh_resolver::lookup::99",
                "tool_secbackup\\local\\trust\\developer_settings::from_value::124",
                "tool_secbackup\\local\\trust\\developer_settings::from_value::127"
            ]
        },
        "FunctionCallRemoval": {
            "ignore": ["tool_secbackup\\local\\net\\object_transport::get_to_file::174"]
        },
        "GreaterThanOrEqualTo": {
            "ignore": ["tool_secbackup\\local\\net\\object_transport::check_status::331"]
        },
        "IncrementInteger": {
            "ignore": [
                "tool_secbackup\\local\\api\\client::exact_object::611",
                "tool_secbackup\\local\\net\\doh_resolver::lookup::127",
                "tool_secbackup\\local\\net\\transport::send::186",
                "tool_secbackup\\local\\trust\\sec_trust::open::102"
            ]
        },
        "LessThan": {
            "ignore": ["tool_secbackup\\local\\crypto\\padme::length::41"]
        },
        "PregMatchRemoveCaret": {
            "ignore": ["tool_secbackup\\local\\crypto\\base64url::decode::46"]
        },
        "TrueValue": {
            "ignore": ["tool_secbackup\\local\\api\\client::upload_request::711"]
        },
        "UnwrapArrayMap": {
            "ignore": ["tool_secbackup\\local\\trust\\sec_trust::current::67"]
        },
        "UnwrapArrayValues": {
            "ignore": [
                "tool_secbackup\\local\\api\\client::upload_urls::370",
                "tool_secbackup\\local\\net\\aws_ranges::from_json::245"
            ]
        },
        "UnwrapTrim": {
            "ignore": ["tool_secbackup\\local\\net\\transport::retry_after::201"]
        }
    },
    "logs": {
        // Relative to this folder. The JSON logs are what .dev/infection/merge.php adds up for the shards on GitHub.
        "text": "out/infection.log",
        "summary": "out/summary.log",
        "summaryJson": "out/summary.json",
        "json": "out/infection.json"
    }
}
